{
  "model": {
    "type": "select",
    "property": "custom_model_data",
    "fallback": {
      "type": "model",
      "model": "item/honeycomb"
    },
    "cases": [
      {
        "when": "shirowh",
        "model": {
          "type": "model",
          "model": "item/shirowh"
        }
      },
      {
        "when": "vaynilo",
        "model": {
          "type": "model",
          "model": "item/vaynilo"
		}
      },
	  {
        "when": "vorticepen",
        "model": {
          "type": "model",
          "model": "item/vorticepen"
      }
      },
      {
        "when": "logo",
        "model": {
          "type": "model",
          "model": "item/logo_beta"
      }
      },
      {
        "when": "skyreapers",
        "model": {
          "type": "model",
          "model": "item/skyreapers"
      }
      },
      {
        "when": "spark",
        "model": {
          "type": "model",
          "model": "item/sparks"
      }
      }
    ]
  }
}